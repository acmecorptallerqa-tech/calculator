{
  "name": "calculator",
  "version": "1.0.0",
  "description": "A production-ready calculator application following Clean Architecture principles",
  "main": "public/app.js",
  "type": "module",
  "scripts": {
    "start": "npx http-server ./public -p 8080 -o",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.js\" \"public/**/*.{html,css,js}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"public/**/*.{html,css,js}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "calculator",
    "clean-architecture",
    "javascript",
    "html",
    "css"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.0.3"
  }
}
